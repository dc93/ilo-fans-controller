<?php
/*
  [!] DO NOT EDIT THIS FILE [!]

  This file is used to get the
  iLO access credentials via
  environment variables.
  Used when deploying with Docker.
*/

$ILO_HOST = getenv('ILO_HOST');
$ILO_USERNAME = getenv('ILO_USERNAME');
$ILO_PASSWORD = getenv('ILO_PASSWORD');

// SSH Key Authentication (optional)
$ILO_SSH_PUBLIC_KEY = getenv('ILO_SSH_PUBLIC_KEY') ?: '';
$ILO_SSH_PRIVATE_KEY = getenv('ILO_SSH_PRIVATE_KEY') ?: '';
$ILO_SSH_KEY_PASSPHRASE = getenv('ILO_SSH_KEY_PASSPHRASE') ?: '';

?>
